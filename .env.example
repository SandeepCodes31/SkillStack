# SkillStack LMS - Environment Variables Reference
# ========================================================
# Duplicate this file or the respective server/.env.example and client/.env.example
# to configure your local development or production environments.

# --- SERVER CONFIGURATION (server/.env) ---
# Port and Environment
PORT=8080
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lms?retryWrites=true&w=majority

# JWT Secret for Session Authentication (use a 64+ char random string in production)
SECRET_KEY=your_super_secret_jwt_key_here_minimum_32_characters

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_51...your_stripe_publishable_key
WEBHOOK_ENDPOINT_SECRET=whsec_...your_stripe_webhook_secret

# Frontend Allowed Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# --- CLIENT CONFIGURATION (client/.env) ---
# API base URL pointing to backend
VITE_API_BASE_URL=http://localhost:8080
